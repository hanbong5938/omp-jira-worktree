{
  "name": "omp-jira-worktree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "omp (oh-my-pi) extension: browse Jira issues, create Git worktrees / native jj workspaces, and start omp coding-agent sessions with Jira context",
  "license": "MIT",
  "author": "hanbong5938",
  "homepage": "https://github.com/hanbong5938/omp-jira-worktree#readme",
  "repository": { "type": "git", "url": "git+https://github.com/hanbong5938/omp-jira-worktree.git" },
  "bugs": { "url": "https://github.com/hanbong5938/omp-jira-worktree/issues" },
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-extension",
    "omp-plugin",
    "jira",
    "git-worktree",
    "jujutsu",
    "jj",
    "coding-agent",
    "ai-agent",
    "tui"
  ],
  "omp": {
    "extensions": ["./extension.ts"]
  },
  "files": ["extension.ts", "src", "README*.md", "LICENSE", "config.example.json"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.10.3 <19",
    "@oh-my-pi/pi-tui": ">=18.10.3 <19"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": { "optional": true },
    "@oh-my-pi/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.10.3",
    "@oh-my-pi/pi-tui": "18.10.3",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
